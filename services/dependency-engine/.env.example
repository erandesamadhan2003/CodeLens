# Redis connection (must match the Redis service name in docker-compose)
REDIS_HOST=
REDIS_PORT=

# Postgres DSN — asyncpg uses the plain postgresql:// scheme (no driver prefix)
DATABASE_URL=

# BullMQ queue name — must match what the api-gateway enqueues into
QUEUE_NAME=

# Number of jobs processed in parallel by this worker
WORKER_CONCURRENCY=

# Groq API key for plain-English scan summaries (optional — falls back to template if unset)
GROQ_API_KEY=
