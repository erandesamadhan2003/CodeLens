# Redis connection (must match docker-compose service name)
REDIS_HOST=redis
REDIS_PORT=6379

# Postgres DSN — asyncpg uses postgresql:// (no driver prefix)
DATABASE_URL=postgresql://user:password@db:5432/codelens

# BullMQ queue name
QUEUE_NAME=documentation-engine

# Parallel job workers
WORKER_CONCURRENCY=4

# Groq AI documentation suggestions (optional — skipped if unset)
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
ENABLE_AI_SUGGESTIONS=true
